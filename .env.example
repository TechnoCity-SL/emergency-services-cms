HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Database
# Local dev (`npm run develop`) uses SQLite at DATABASE_FILENAME.
# Production (NODE_ENV=production) uses the Supabase Postgres settings below.
# Uncomment DATABASE_CLIENT to override the default for the current environment.
# DATABASE_CLIENT=postgres
DATABASE_FILENAME=.tmp/data.db

# Supabase Postgres (production)
DATABASE_HOST=aws-0-your-project-region.pooler.supabase.com
DATABASE_PORT=5432
DATABASE_NAME=postgres
DATABASE_USERNAME=postgres.your-project-ref
DATABASE_PASSWORD=tobemodified
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=false
DATABASE_URL=postgresql://postgres.your-project-ref:url-encoded-password@aws-0-your-project-region.pooler.supabase.com:5432/postgres

# Cloudinary
CLOUDINARY_NAME=tobemodified
CLOUDINARY_KEY=tobemodified
CLOUDINARY_SECRET=tobemodified
CLOUDINARY_FOLDER=emergency-services
